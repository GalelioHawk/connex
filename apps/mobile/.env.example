# ============================================================================
# CONNEX MOBILE — ENVIRONMENT VARIABLES
# File: apps/mobile/.env.example
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value (see comments for where to find each value)
#   3. NEVER commit .env to GitHub — it is in .gitignore
#
# In Expo, prefix all variables with EXPO_PUBLIC_ to access them in app code.
# ============================================================================

# ── CONVEX ───────────────────────────────────────────────────────────────────
# Found in: Convex Dashboard → your project → Settings → URL & Deploy Key
# Run `npx convex dev` first to initialize the project and get this URL.

EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ── PUSH NOTIFICATIONS ───────────────────────────────────────────────────────
# Expo push tokens are issued using the EAS project ID in app.json.
# Keep the Firebase sender ID only if your Android credentials require it.

EXPO_PUBLIC_FIREBASE_SENDER_ID=your-firebase-sender-id

# ── APP CONFIG ────────────────────────────────────────────────────────────────

EXPO_PUBLIC_APP_ENV=development

# ── AGORA (voice & video calls) ──────────────────────────────────────────────
# Found in: Agora Console → your project → App ID
# For testing: leave App Certificate DISABLED in Agora Console (no token needed).

EXPO_PUBLIC_AGORA_APP_ID=

# ============================================================================
# CONVEX ENVIRONMENT VARIABLES (set in Convex Dashboard, NOT here)
# These live on the Convex server — never in the mobile app .env.
#
# APP_ENV                    = development | production
# ESKOMSEPUSH_API_KEY        = EskomSePush API key
# AGORA_APP_ID               = server-side Agora app ID
# AGORA_APP_CERTIFICATE      = server-side Agora app certificate
# ============================================================================
